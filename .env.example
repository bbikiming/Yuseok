# 토스증권 Open API 자격 증명 — 실제 값은 .env 에만 넣고 절대 커밋하지 마세요.
# 사용법: cp .env.example .env  후 값 채우기

# OAuth2 Client Credentials (콘솔에서 발급)
TOSS_CLIENT_ID=c_xxxxxxxxxxxxxxxxxxxxxx
TOSS_CLIENT_SECRET=s_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 선택: accountSeq 를 고정하고 싶을 때 (미설정 시 GET /api/v1/accounts 로 자동 조회)
# TOSS_ACCOUNT_SEQ=1

# 선택: 휴대폰 알림 (화면의 설정 → "휴대폰 알림"에서 넣으면 여기에 자동으로 적힙니다)
# TRADEBOT_NOTIFY=ntfy                # telegram / ntfy / 비우면 꺼짐
# TRADEBOT_NTFY_TOPIC=puddle-xxxxxxxxxxxxxxxx
# TRADEBOT_TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TRADEBOT_TELEGRAM_CHAT=123456789
# TRADEBOT_NOTIFY_ENTRY=1             # 연습으로 샀을 때
# TRADEBOT_NOTIFY_EXIT=1              # 팔았을 때(결과)

# 선택: 집 밖에서 화면을 열 때 쓰는 주소 (VPN 주소. 화면의 설정에서 넣으면 자동으로 적힙니다)
# TRADEBOT_OUTSIDE_URL=http://100.101.102.103:8765
