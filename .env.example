# 토스증권 Open API 자격 증명 — 실제 값은 .env 에만 넣고 절대 커밋하지 마세요.
# 사용법: cp .env.example .env  후 값 채우기

# OAuth2 Client Credentials (콘솔에서 발급)
TOSS_CLIENT_ID=c_xxxxxxxxxxxxxxxxxxxxxx
TOSS_CLIENT_SECRET=s_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 선택: accountSeq 를 고정하고 싶을 때 (미설정 시 GET /api/v1/accounts 로 자동 조회)
# TOSS_ACCOUNT_SEQ=1
